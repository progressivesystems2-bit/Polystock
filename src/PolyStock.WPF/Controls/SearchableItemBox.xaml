<UserControl x:Class="PolyStock.WPF.Controls.SearchableItemBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PolyStock.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="38" d:DesignWidth="280">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <!-- Main Input Container -->
        <Border x:Name="InputBorder"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderThickness="1.5"
                CornerRadius="6"
                Height="36">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RootGrid}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search / Selected Text Box -->
                <TextBox x:Name="PART_TextBox"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         Padding="8,4"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         PreviewKeyDown="PART_TextBox_PreviewKeyDown"
                         TextChanged="PART_TextBox_TextChanged"
                         GotFocus="PART_TextBox_GotFocus"
                         LostFocus="PART_TextBox_LostFocus" />

                <!-- Placeholder / Hint -->
                <TextBlock x:Name="PART_Placeholder"
                           Grid.Column="0"
                           Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Visibility="Visible" />

                <!-- Clear Button (visible when text is entered) -->
                <Button x:Name="ClearButton"
                        Grid.Column="1"
                        Content="✕"
                        Width="20" Height="20"
                        Margin="0,0,2,0"
                        Padding="0"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ClearButton_Click"
                        Focusable="False"
                        ToolTip="Clear selection"
                        Visibility="Collapsed" />

                <!-- Dropdown Chevron Button -->
                <Button x:Name="DropDownButton"
                        Grid.Column="2"
                        Width="26" Height="34"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Cursor="Hand"
                        Click="DropDownButton_Click"
                        ToolTip="Open items dropdown (Alt+Down)">
                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{DynamicResource SecondaryTextBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- Search Results Popup -->
        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide"
               Opened="PART_Popup_Opened"
               Closed="PART_Popup_Closed">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="6"
                    MinWidth="{Binding ActualWidth, ElementName=RootGrid}"
                    MaxWidth="480"
                    MaxHeight="320"
                    Margin="0,2,0,10"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.25" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header Hint Bar: Displays Row 1 Category context when active -->
                    <Border x:Name="PriorityHeaderBorder"
                            Grid.Row="0"
                            Background="#F0FDF4"
                            BorderBrush="#BBF7D0"
                            BorderThickness="0,0,0,1"
                            Padding="8,5"
                            Visibility="Collapsed">
                        <TextBlock x:Name="PriorityHeaderText"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#166534"
                                   Text="💡 Starting with same Brand &amp; Group from Row 1" />
                    </Border>

                    <!-- Items List -->
                    <ListBox x:Name="PART_ListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             PreviewMouseLeftButtonDown="PART_ListBox_PreviewMouseLeftButtonDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="2,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    CornerRadius="5"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CBD5E1" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#E0F2FE" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#38BDF8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SearchableItemWrapper}">
                                <Border Padding="8,6" CornerRadius="4" Background="Transparent">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Line 1: Item Name -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding Item.ItemName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                                        <!-- Line 1 Right: Default Rate per kg -->
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding RateText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />

                                        <!-- Line 2: Badges (Priority, Brand, Group, Code) -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    Margin="0,3,0,0">
                                            <!-- Priority Match Indicator -->
                                            <Border Background="#DCFCE7" CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                    Visibility="{Binding IsPriorityMatch, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="★ Row 1 Match" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" />
                                            </Border>

                                            <!-- Brand Badge -->
                                            <Border Background="#E0E7FF" CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                    Visibility="{Binding HasBrand, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding Item.BrandName}" FontSize="9.5" FontWeight="SemiBold" Foreground="#3730A3" />
                                            </Border>

                                            <!-- HeadGroup Badge -->
                                            <Border Background="#F3F4F6" CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                    Visibility="{Binding HasHeadGroup, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding Item.HeadGroupName}" FontSize="9.5" Foreground="#4B5563" />
                                            </Border>

                                            <!-- Item Code -->
                                            <TextBlock Text="{Binding Item.ItemCode, StringFormat='({0})'}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasCode, Converter={StaticResource BoolToVisConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state text if no matches -->
                    <TextBlock x:Name="NoMatchesText"
                               Grid.Row="1"
                               Text="No matching items found"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20"
                               Visibility="Collapsed" />

                    <!-- Footer hint -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8,4">
                        <DockPanel>
                            <TextBlock Text="★ Priority: Matching Row 1"
                                       FontSize="10"
                                       Foreground="#15803D"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="▲▼ Navigate • Enter Select • Esc Close"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
