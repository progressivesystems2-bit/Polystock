        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="{DynamicResource StatusBarBackgroundBrush}" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Left: DB & Dual UoM Status -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="● MS Access: Online" FontSize="11" Foreground="{DynamicResource StatusBarTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="• Dual UoM: Active" FontSize="11" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: App Version & Active Theme Palette -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource StatusBarShortcutButton}"
                            Command="{Binding CheckForUpdatesCommand}"
                            ToolTip="Click to check for updates (Velopack)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀 v" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding SelectedThemeId, StringFormat='Active Palette: {0}'}" FontSize="11" Foreground="{DynamicResource StatusBarMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- Center: Dynamic Page Shortcuts Button which opens the Shortcuts Page -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource StatusBarShortcutButton}"
                            Command="{Binding OpenShortcutsCommand}"
                            ToolTip="{Binding CurrentPageShortcutsTooltip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⌨ Shortcuts (F1):" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentPageShortcutsSummary}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text=" • [Open Guide]" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
