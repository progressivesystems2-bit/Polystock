<Window x:Class="PolyStock.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PolyStock.WPF.Converters"
        xmlns:views="clr-namespace:PolyStock.WPF.Views"
        xmlns:vm="clr-namespace:PolyStock.WPF.ViewModels"
        mc:Ignorable="d"
        Title="PolyStock - Polymer &amp; Commodity Bag Inventory &amp; Sales Management" 
        Height="860" Width="1440"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Segoe UI Variable, Inter, sans-serif"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenShortcutsCommand}" />
        <KeyBinding Key="F5" Command="{Binding OpenPaymentCommand}" />
        <KeyBinding Key="F6" Command="{Binding OpenReceiptCommand}" />
        <KeyBinding Key="F7" Command="{Binding OpenJournalCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />

        <!-- Status Bar Shortcut Button Style -->
        <Style x:Key="StatusBarShortcutButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Menu & App Header -->
            <RowDefinition Height="Auto" />
            <!-- Dynamic Document Tabs Strip -->
            <RowDefinition Height="Auto" />
            <!-- Full Width Workspace Content -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 1. TOP BAR: Brand Header + Dropdown Menu Bar -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBackgroundBrush}" BorderBrush="{DynamicResource TopBarBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <DockPanel>
                <!-- Brand Identity -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Width="30" Height="30" Margin="0,0,8,0">
                        <TextBlock Text="PS" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="POLY" FontWeight="Black" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="STOCK" FontWeight="Black" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- TOP MENU BAR: Dropdown Menus -->
                <Menu VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- Master Data Menu -->
                    <MenuItem Header="📁 Master Data">
                        <MenuItem Header="🏷 Item Master" Command="{Binding OpenTabCommand}" CommandParameter="ItemCreation" IsEnabled="{Binding CanAccessItemMaster}" />
                        <MenuItem Header="📁 Head Group Master" Command="{Binding OpenTabCommand}" CommandParameter="HeadGroup" IsEnabled="{Binding CanAccessHeadGroupMaster}" />
                        <MenuItem Header="🏢 Brand Master" Command="{Binding OpenTabCommand}" CommandParameter="Brand" IsEnabled="{Binding CanAccessBrandMaster}" />
                        <MenuItem Header="🏭 Godown Master" Command="{Binding OpenTabCommand}" CommandParameter="Godown" IsEnabled="{Binding CanAccessGodownMaster}" />
                        <MenuItem Header="👥 Account Master" Command="{Binding OpenTabCommand}" CommandParameter="AccountCreation" IsEnabled="{Binding CanAccessAccountMaster}" />
                        <Separator />
                        <MenuItem Header="🔐 User &amp; Security Roles" Command="{Binding OpenTabCommand}" CommandParameter="UserSecurity" IsEnabled="{Binding CanAccessUserSecurity}" />
                        <MenuItem Header="⚙ System Settings" Command="{Binding OpenTabCommand}" CommandParameter="Settings" IsEnabled="{Binding CanAccessSettings}" />
                    </MenuItem>

                    <!-- Transactions Menu -->
                    <MenuItem Header="🛒 Transactions">
                        <MenuItem Header="🛒 Sales Entry (Dual-Qty)" Command="{Binding OpenTabCommand}" CommandParameter="Sales" IsEnabled="{Binding CanAccessSales}" />
                        <MenuItem Header="📥 Purchase Inward" Command="{Binding OpenTabCommand}" CommandParameter="Purchase" IsEnabled="{Binding CanAccessPurchase}" />
                        <MenuItem Header="🚚 Stock Transfer (Godowns)" Command="{Binding OpenTabCommand}" CommandParameter="StockTransfer" IsEnabled="{Binding CanAccessStockTransfer}" />
                        <MenuItem Header="💰 Payments &amp; Receipts (F5/F6/F7)" Command="{Binding OpenTabCommand}" CommandParameter="Vouchers" IsEnabled="{Binding CanAccessVouchers}" />
                    </MenuItem>

                    <!-- Reports & Stock Menu -->
                    <MenuItem Header="📊 Reports &amp; Stock">
                        <MenuItem Header="📊 Dashboard Overview" Command="{Binding OpenTabCommand}" CommandParameter="Dashboard" IsEnabled="{Binding CanAccessDashboard}" />
                        <MenuItem Header="📦 Live Stock Register" Command="{Binding OpenTabCommand}" CommandParameter="StockRegister" IsEnabled="{Binding CanAccessStockRegister}" />
                        <MenuItem Header="📋 Invoices &amp; History" Command="{Binding OpenTabCommand}" CommandParameter="Invoices" IsEnabled="{Binding CanAccessInvoices}" />
                        <MenuItem Header="📒 Account &amp; Group Ledgers" Command="{Binding OpenTabCommand}" CommandParameter="LedgerReports" IsEnabled="{Binding CanAccessLedgerReports}" />
                        <MenuItem Header="📈 Profit &amp; Loss (P/L) Report" Command="{Binding OpenTabCommand}" CommandParameter="ProfitLossReport" IsEnabled="{Binding CanAccessProfitLossReport}" />
                    </MenuItem>

                    <!-- Settings Menu -->
                    <MenuItem Header="⚙ Settings">
                        <MenuItem Header="⚙ System Settings" Command="{Binding OpenTabCommand}" CommandParameter="Settings" IsEnabled="{Binding CanAccessSettings}" />
                    </MenuItem>

                    <!-- Help & Updates Menu -->
                    <MenuItem Header="❓ Help">
                        <MenuItem Header="⌨ Keyboard Shortcuts (F1)" Command="{Binding OpenShortcutsCommand}" />
                        <Separator />
                        <MenuItem Header="🔄 Check for Updates..." Command="{Binding CheckForUpdatesCommand}" />
                        <MenuItem Header="ℹ About PolyStock" Command="{Binding AboutCommand}" />
                    </MenuItem>
                </Menu>

                <!-- Right Side: Global Search Box + Dual-Unit indicator + Theme Picker -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Global Search Box -->
                    <Grid Margin="0,0,14,0">
                        <Border x:Name="SearchBoxBorder"
                                Width="290" Height="34"
                                CornerRadius="8"
                                Background="{DynamicResource TopBarSearchBgBrush}"
                                BorderBrush="{DynamicResource TopBarSearchBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{DynamicResource TopBarSearchIconBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />

                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Search items, accounts, bills... (Ctrl+F)"
                                               FontSize="12"
                                               Foreground="{DynamicResource TopBarSearchPlaceholderBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchTextBox}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBox x:Name="GlobalSearchTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             Height="28"
                                             FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Foreground="{DynamicResource TopBarSearchTextBrush}"
                                             CaretBrush="{DynamicResource TopBarSearchCaretBrush}"
                                             Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <!-- Clear Button -->
                                <Button Grid.Column="2"
                                        Command="{Binding ClearGlobalSearchCommand}"
                                        Content="✕"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TopBarSearchPlaceholderBrush}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="4,2"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchTextBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Global Search Popup -->
                        <Popup x:Name="GlobalSearchPopup"
                               IsOpen="{Binding IsGlobalSearchOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=SearchBoxBorder}"
                               HorizontalOffset="0"
                               VerticalOffset="6">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Results List Box -->
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6"
                                            Width="380"
                                            MaxHeight="420">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000" />
                                        </Border.Effect>

                                        <DockPanel>
                                            <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="8,4" Margin="4,4,4,0">
                                                <TextBlock Text="Use ↑/↓ to navigate • Enter to open • Esc to close" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                            </Border>

                                            <ListBox x:Name="GlobalSearchResultsList"
                                                     ItemsSource="{Binding GlobalSearchResults}"
                                                     SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                                     SelectionChanged="GlobalSearchResultsList_SelectionChanged"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="2"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <EventSetter Event="MouseEnter" Handler="GlobalSearchResultItem_MouseEnter" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,1" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="7"
                                                                            Padding="6,5">
                                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.OpenGlobalSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="2"
                                                                Cursor="Hand"
                                                                IsTabStop="False"
                                                                HorizontalContentAlignment="Stretch">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource PanelBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                <!-- Badge -->
                                                                <Border Grid.Column="2" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#1A0078D4" />
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>

                                    <!-- Quick Details Card (Adjacent on Right) -->
                                    <Border Margin="8,0,0,0"
                                            Width="300"
                                            MaxHeight="420"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSearchResult.HasAnyDetails}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000" />
                                        </Border.Effect>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <!-- Account Quick Details -->
                                                <StackPanel DataContext="{Binding SelectedSearchResult.AccountDetails}">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.SelectedSearchResult.HasAccountDetails, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <!-- Header -->
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource PanelBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AccountName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountName}"/>
                                                            <TextBlock Text="{Binding AccountType, StringFormat='Party Type: {0}'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,10"/>

                                                    <!-- Details Rows -->
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Mobile:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Width="70" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding Mobile, TargetNullValue='—'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="70,0,0,0" TextTrimming="CharacterEllipsis" />
                                                        </Grid>

                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="GSTIN:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Width="70" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding GSTIN, TargetNullValue='—'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="70,0,0,0" TextTrimming="CharacterEllipsis" />
                                                        </Grid>

                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Balance:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Width="70" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding BalanceDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="70,0,0,0" />
                                                        </Grid>

                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Email:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Width="70" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding Email, TargetNullValue='—'}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="70,0,0,0" TextTrimming="CharacterEllipsis" />
                                                        </Grid>

                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Address:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Width="70" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding Address, TargetNullValue='—'}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="70,0,0,0" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Item Quick Details -->
                                                <StackPanel DataContext="{Binding SelectedSearchResult.ItemDetails}">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.SelectedSearchResult.HasItemDetails, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <!-- Header -->
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource PanelBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="🏷" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ItemName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ItemName}"/>
                                                            <TextBlock Text="{Binding ItemCode, StringFormat='Item Code: {0}'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,10"/>

                                                    <!-- Details Rows -->
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Brand:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Width="75" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding BrandName, TargetNullValue='(None)'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="75,0,0,0" />
                                                        </Grid>

                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Category:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Width="75" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding HeadGroupName, TargetNullValue='(Default)'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="75,0,0,0" />
                                                        </Grid>

                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Rate / Kg:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Width="75" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding RateDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="75,0,0,0" />
                                                        </Grid>

                                                        <Grid Margin="0,0,0,6">
                                                            <TextBlock Text="Description:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Width="75" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding Description, TargetNullValue='—'}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="75,0,0,0" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Popup>
                    </Grid>

                    <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme}"
                              DisplayMemberPath="DisplayName"
                              Width="130" Height="30" />

                    <!-- Current User & Logout/Switch User -->
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="11.5" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentUserDisplay}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Style="{StaticResource StatusBarShortcutButton}"
                                    Command="{Binding SwitchUserCommand}"
                                    ToolTip="Switch user or log out"
                                    Padding="6,2" FontSize="10">
                                <TextBlock Text="Switch" FontSize="10" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. DYNAMIC DOCUMENT TABS STRIP (Only loaded/opened tabs appear here) -->
        <Border Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="12,4,12,0">
            <ListBox ItemsSource="{Binding OpenTabs}"
                     SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource DynamicDocTabItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <!-- 3. MAIN WORKSPACE CANVAS -->
        <Grid Grid.Row="2" Margin="14,10,14,10">
            <views:DashboardView 
                DataContext="{Binding DashboardVM}"
                Visibility="{Binding DataContext.CurrentViewName, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Dashboard}" />
            <views:SalesView 
                DataContext="{Binding SalesVM}"
