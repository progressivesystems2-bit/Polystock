<Window x:Class="PolyStock.WPF.Views.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PolyStock - Error Intercepted"
        Height="500" Width="600"
        MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0. Header with Shield / Protection Badge -->
            <RowDefinition Height="Auto" />
            <!-- 1. Friendly Explanation Banner -->
            <RowDefinition Height="Auto" />
            <!-- 2. Technical Details Expander / Box -->
            <RowDefinition Height="*" />
            <!-- 3. Action Buttons Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="44" Height="44" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1.5" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Error Intercepted — Application Protected" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="PolyStock caught this exception and prevented the application from closing abruptly."
                           FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- 1. Explanation Banner -->
        <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="What happened?" FontWeight="Bold" FontSize="12" Foreground="#92400E" />
                <TextBlock x:Name="ErrorMessageText"
                           Text="An unexpected operation error occurred."
                           FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#78350F"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 2. Technical Details Card -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="14" Margin="0,0,0,16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Technical Diagnostics &amp; Stack Trace" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CopyStatusText" Text="" FontWeight="SemiBold" FontSize="11" Foreground="#15803D" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>

                <TextBox x:Name="StackTraceTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="11"
                         Background="#F8FAFC"
                         Foreground="#334155"
                         BorderBrush="{DynamicResource CardBorderBrush}"
                         BorderThickness="1"
                         Padding="10" />
            </DockPanel>
        </Border>

        <!-- 3. Action Buttons -->
        <DockPanel Grid.Row="3">
            <Button x:Name="CopyButton"
                    Content="📋 Copy Error Details"
                    Style="{StaticResource SecondaryButton}"
                    Padding="14,8"
                    Click="CopyButton_Click"
                    ToolTip="Copies error message and complete stack trace to clipboard" />

            <Button x:Name="OpenLogButton"
                    Content="📁 View Error Log"
                    Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0"
                    Padding="14,8"
                    Click="OpenLogButton_Click"
                    ToolTip="Opens the persistent log file on disk" />

            <Button x:Name="ContinueButton"
                    Content="✓ Continue Working"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Padding="20,8"
                    IsDefault="True"
                    Click="ContinueButton_Click"
                    ToolTip="Dismiss this dialog and continue using PolyStock" />
        </DockPanel>
    </Grid>
</Window>
