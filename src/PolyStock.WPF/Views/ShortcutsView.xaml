<UserControl x:Class="PolyStock.WPF.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:PolyStock.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1200">

    <UserControl.Resources>
        <conv:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Keycap badge style mimicking physical keyboard key -->
        <Style x:Key="KeyCapBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" Opacity="0.08" ShadowDepth="1" Direction="270" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryFilterPill" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0. Header Banner & Search -->
            <RowDefinition Height="Auto" />
            <!-- 1. Category Filter Pills Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2. Shortcuts Cards List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. HEADER BANNER & SEARCH -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="18,14">
            <DockPanel>
                <!-- Left Title & Description -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="6,3" Margin="0,0,10,0">
                            <TextBlock Text="⌨ HOTKEYS" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Black" FontSize="11" />
                        </Border>
                        <TextBlock Text="PolyStock Keyboard Shortcuts &amp; Fast-Keys Cheatsheet" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Instant keystroke navigation and rapid data entry across all modules without touching the mouse." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Right: Search Bar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2" Width="320" Height="38">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13"
                                     ToolTip="Search by key (F8, Ctrl+A), action or module" />
                            <Button Grid.Column="2" Content="✕" Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchText.Length, Converter={StaticResource BoolToVisConverter}}"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}"
                                    Cursor="Hand" Padding="4,0" FontWeight="Bold" ToolTip="Clear search" />
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. CATEGORY FILTER PILLS -->
        <Border Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="8,6">
            <DockPanel>
                <TextBlock Text="Filter by Module:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="6,0,12,0" />
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}"
                                         Margin="0,0,6,0"
                                         Style="{StaticResource CategoryFilterPill}"
                                         Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource EqualityToBoolConverter}" Mode="OneWay">
                                        <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        <Binding />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 2. SHORTCUTS CARDS GRID -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredShortcuts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="560" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ModernCard}" Margin="0,0,12,12" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Keycap presentation -->
                                    <ColumnDefinition Width="130" />
                                    <!-- Details & descriptions -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Action button -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Stylized Keycap -->
                                <Border Grid.Column="0" Style="{StaticResource KeyCapBadge}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Key}" FontWeight="Black" FontSize="13" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas, Segoe UI, sans-serif" TextAlignment="Center" />
                                </Border>

                                <!-- Center: Description -->
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Action}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BadgeBackgroundBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding CategoryTitle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>

                                <!-- Right: Navigate Button -->
                                <Button Grid.Column="2"
                                        Content="🚀 Open"
                                        Command="{Binding DataContext.NavigateToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding PageId}"
                                        Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVisConverter}}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" FontSize="11" Height="28" VerticalAlignment="Center"
                                        ToolTip="Jump directly to this module" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
