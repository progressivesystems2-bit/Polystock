<Window x:Class="PolyStock.WPF.Views.PrintProfitLossWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PolyStock.WPF.Converters"
        mc:Ignorable="d"
        Title="Profit &amp; Loss (P/L) Report Preview - PolyStock"
        Height="850" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="#525659">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConverter" />
        <conv:WeightConverter x:Key="WeightConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Print Toolbar -->
        <Border Grid.Row="0" Background="#323639" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📈 Profit &amp; Loss (P/L) Trading Analysis Report Preview" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <Border Background="#4B5563" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="{Binding DateRangeDisplay}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🖨  Print Report" Background="#2B7DE9" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,8" Margin="0,0,10,0" Click="Print_Click" Cursor="Hand" />
                    <Button Content="Close" Background="#4F5356" Foreground="#FFFFFF" Padding="14,8" Click="Close_Click" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Printable Document Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border x:Name="PrintArea"
                    Background="#FFFFFF"
                    Width="980"
                    MinHeight="1050"
                    Margin="20"
                    Padding="36"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="4" Direction="270" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- Company & Document Title Header -->
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="POLYSTOCK POLYMERS &amp; COMMODITIES" FontSize="20" FontWeight="Black" Foreground="#111827" />
                            <TextBlock Text="Weighted Average Profit &amp; Loss (P/L) Trading Statement" FontSize="11" Foreground="#4B5563" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DateRangeDisplay}" FontSize="12" FontWeight="Black" Foreground="#1F2937" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding FilteredItemCount, StringFormat='{}{0} Traded Items'}" FontSize="9" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Separator Background="#111827" Height="2" Margin="0,0,0,14" />

                    <!-- KPI Summary Ribbon -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL SALES REVENUE" FontSize="9" FontWeight="Bold" Foreground="#6B7280" />
                                <TextBlock Text="{Binding FormattedTotalRevenue}" FontSize="15" FontWeight="Black" Foreground="#111827" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding FormattedTotalSoldWeight, StringFormat='Qty: {0}'}" FontSize="10" Foreground="#4B5563" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="COST OF GOODS (COGS)" FontSize="9" FontWeight="Bold" Foreground="#6B7280" />
                                <TextBlock Text="{Binding FormattedTotalCogs}" FontSize="15" FontWeight="Black" Foreground="#4B5563" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Summary.TotalSoldBags, StringFormat='{}{0} Bags Sold'}" FontSize="10" Foreground="#4B5563" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="NET PROFIT / LOSS" FontSize="9" FontWeight="Bold" Foreground="#6B7280" />
                                <TextBlock Text="{Binding FormattedNetProfitLoss}" FontSize="15" FontWeight="Black" Foreground="{Binding IsNetProfitable, Converter={x:Null}}" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#059669" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetProfitable}" Value="False">
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding FormattedMarginPercent, StringFormat='Margin: {0}'}" FontSize="10" FontWeight="Bold" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="PROFIT / KG" FontSize="9" FontWeight="Bold" Foreground="#6B7280" />
                                <TextBlock Text="{Binding FormattedAvgProfitPerKg}" FontSize="15" FontWeight="Black" Foreground="#111827" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Summary.ProfitableItemsCount, StringFormat='{}{0} Profitable Items'}" FontSize="10" Foreground="#059669" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Items Table -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                        <DataGrid ItemsSource="{Binding FilteredRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F3F4F6"
                                  BorderThickness="0"
                                  Background="#FFFFFF"
                                  RowHeight="26"
                                  FontSize="11">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F4F6" />
                                    <Setter Property="Foreground" Value="#374151" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="Padding" Value="6,2" />
                                    <Setter Property="BorderBrush" Value="#E5E7EB" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName}" Width="2.2*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding HeadGroupName}" Width="*" />
                                <DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="*" />
                                <DataGridTextColumn Header="Bags" Binding="{Binding SoldBags}" Width="45">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Sold Weight" Binding="{Binding SoldKg, StringFormat='{}{0:N1} kg'}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Avg Sale Rate" Binding="{Binding FormattedAvgSaleRate}" Width="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total Sales (₹)" Binding="{Binding FormattedSalesAmount}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Cost Rate" Binding="{Binding FormattedPurchaseRate}" Width="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="COGS (₹)" Binding="{Binding FormattedCogsAmount}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Profit/Loss (₹)" Binding="{Binding FormattedProfitLossSigned}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#059669" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Margin %" Binding="{Binding FormattedMarginPercent}" Width="65">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Summary / Footer Signature -->
                    <Grid Margin="0,20,0,0">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="* Note: Weighted Average Purchase Rate uses period inward purchases. If not purchased in period, historical purchase rate or item master rate is used as cost basis."
                                       FontSize="9" Foreground="#6B7280" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="600" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="For PolyStock Polymers" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                            <TextBlock Text="Authorized Signatory" FontSize="10" Foreground="#4B5563" HorizontalAlignment="Right" Margin="0,30,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
