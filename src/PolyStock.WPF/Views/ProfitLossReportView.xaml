<UserControl x:Class="PolyStock.WPF.Views.ProfitLossReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:PolyStock.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConverter" />
        <conv:WeightConverter x:Key="WeightConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header & Date Range Controls -->
            <RowDefinition Height="Auto" />
            <!-- 1: KPI Summary Metric Cards -->
            <RowDefinition Height="Auto" />
            <!-- 2: Filter Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 3: Main DataGrid -->
            <RowDefinition Height="*" />
            <!-- 4: Footer Info Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: HEADER & DATE RANGE CONTROLS -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <DockPanel>
                <!-- Title & Subtitle -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="📈" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Profit &amp; Loss (P/L) Report"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Weighted average purchase cost vs sales realization trading analysis"
                               FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="38,2,0,0" />
                </StackPanel>

                <!-- Date Range Controls & Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Date Presets -->
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Period Preset:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding DatePresets}"
                                  SelectedItem="{Binding SelectedDatePreset}"
                                  Width="140"
                                  Height="30" />
                    </StackPanel>

                    <!-- From Date -->
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="From Date:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                    Width="125"
                                    Height="30" />
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="To Date:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                    Width="125"
                                    Height="30" />
                    </StackPanel>

                    <!-- Generate / Refresh Button -->
                    <Button Command="{Binding RefreshCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentTextBrush}"
                            FontWeight="Bold"
                            Height="30"
                            Padding="14,0"
                            Margin="0,15,8,0"
                            Cursor="Hand"
                            ToolTip="Generate / Refresh Report with selected dates">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="11" />
                            <TextBlock Text="Generate" FontSize="11.5" />
                        </StackPanel>
                    </Button>

                    <!-- Export CSV Button -->
                    <Button Command="{Binding ExportCsvCommand}"
                            IsEnabled="{Binding CanPrint}"
                            Background="{DynamicResource PanelBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Height="30"
                            Padding="12,0"
                            Margin="0,15,8,0"
                            Cursor="Hand"
                            ToolTip="Export Report to CSV / Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥 " FontSize="11" />
                            <TextBlock Text="Export CSV" FontSize="11.5" />
                        </StackPanel>
                    </Button>

                    <!-- Print Report Button -->
                    <Button Command="{Binding PrintReportCommand}"
                            IsEnabled="{Binding CanPrint}"
                            Background="{DynamicResource PanelBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Height="30"
                            Padding="12,0"
                            Margin="0,15,0,0"
                            Cursor="Hand"
                            ToolTip="Print or Preview P/L Statement">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨 " FontSize="11" />
                            <TextBlock Text="Print" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1: KPI SUMMARY METRIC CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Sales Revenue -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL SALES REVENUE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding FormattedTotalRevenue}"
                               FontSize="18"
                               FontWeight="Black"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,4,0,2" />
                    <TextBlock Text="{Binding FormattedTotalSoldWeight, StringFormat='Sold: {0}'}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 2: Cost of Goods Sold (COGS) -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="COST OF GOODS (COGS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding FormattedTotalCogs}"
                               FontSize="18"
                               FontWeight="Black"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,2" />
                    <TextBlock Text="{Binding Summary.TotalSoldBags, StringFormat='{}{0} Total Sold Bags'}"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 3: Net Profit / Loss -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,8,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="NET PROFIT / LOSS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding FormattedMarginPercent, StringFormat='Margin: {0}'}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </Border>
                    </DockPanel>

                    <TextBlock Text="{Binding FormattedNetProfitLoss}"
                               FontSize="18"
                               FontWeight="Black"
                               Margin="0,4,0,2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNetProfitable}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding DateRangeDisplay}"
                               FontSize="10.5"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 4: Profit / Kg & Traded Items Count -->
            <Border Grid.Column="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <StackPanel>
                    <TextBlock Text="PROFIT / KG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding FormattedAvgProfitPerKg}"
                               FontSize="18"
                               FontWeight="Black"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,4,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Summary.ProfitableItemsCount, StringFormat='{}{0} Profitable'}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Summary.LossItemsCount, StringFormat='{}{0} Loss'}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ErrorBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2: FILTER TOOLBAR -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <DockPanel>
                <!-- Clear Filters Button on the Right -->
                <Button DockPanel.Dock="Right"
                        Command="{Binding ClearFiltersCommand}"
                        Content="Clear Filters"
                        Background="Transparent"
                        Foreground="{DynamicResource AccentBrush}"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontSize="11.5"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0" />

                <!-- Left: Filter Inputs -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Item Box -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Search Item / Code:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" />
                    </StackPanel>

                    <!-- Category / HeadGroup -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Category:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableHeadGroups}"
                                  SelectedItem="{Binding SelectedHeadGroup}"
                                  Width="150"
                                  Height="28" />
                    </StackPanel>

                    <!-- Brand -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Brand:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableBrands}"
                                  SelectedItem="{Binding SelectedBrand}"
                                  Width="140"
                                  Height="28" />
                    </StackPanel>

                    <!-- Profitability Filter -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Profitability:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding ProfitabilityFilters}"
                                  SelectedItem="{Binding SelectedProfitabilityFilter}"
                                  Width="150"
                                  Height="28" />
                    </StackPanel>

                    <!-- Only Sold Items Checkbox -->
                    <CheckBox IsChecked="{Binding ShowOnlySoldItems}"
                              Content="Only items sold in period"
                              FontSize="11.5"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              VerticalAlignment="Center"
                              Margin="0,12,14,0" />

                    <!-- Count Badge -->
                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="10,4" Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FilteredItemCount, StringFormat='{}{0} Items'}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3: MAIN DATAGRID -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding FilteredRows}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource PanelBrush}"
                      BorderThickness="0"
                      Background="{DynamicResource CardBackgroundBrush}"
                      RowHeight="32"
                      FontSize="12">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Item Description -->
                    <DataGridTemplateColumn Header="Item Description" Width="2.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding ItemName}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="{Binding ItemCode, StringFormat='Code: {0}'}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Category -->
                    <DataGridTextColumn Header="Category" Binding="{Binding HeadGroupName}" Width="*" />

                    <!-- Brand -->
                    <DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="*" />

                    <!-- Bags Sold -->
                    <DataGridTextColumn Header="Sold Bags" Binding="{Binding SoldBags}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Sold Weight (kg) -->
                    <DataGridTextColumn Header="Sold Kg" Binding="{Binding SoldKg, StringFormat='{}{0:N1} kg'}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Weighted Avg Sale Rate -->
                    <DataGridTextColumn Header="Avg Sale Rate" Binding="{Binding FormattedAvgSaleRate}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Total Sales Amount -->
                    <DataGridTextColumn Header="Sales Revenue (₹)" Binding="{Binding FormattedSalesAmount}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Weighted Avg Purchase Rate (Cost basis) -->
                    <DataGridTemplateColumn Header="Cost Rate (₹/kg)" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" ToolTip="{Binding PurchaseRateSource, StringFormat='Cost Basis: {0}'}">
                                    <TextBlock Text="{Binding FormattedPurchaseRate}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding PurchaseRateSource}" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COGS Amount -->
                    <DataGridTextColumn Header="COGS (₹)" Binding="{Binding FormattedCogsAmount}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Gross Profit / Loss Amount -->
                    <DataGridTemplateColumn Header="Profit / Loss (₹)" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E6F4EA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                    <Setter Property="Background" Value="#FCE8E6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding FormattedProfitLossSigned}" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Profit Per Kg -->
                    <DataGridTextColumn Header="Profit/kg" Binding="{Binding FormattedProfitPerKg}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Margin % -->
                    <DataGridTextColumn Header="Margin %" Binding="{Binding FormattedMarginPercent}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4: FOOTER INFO BAR -->
        <Border Grid.Row="4" Background="Transparent" Margin="4,8,4,0">
            <DockPanel>
                <TextBlock Text="💡 Weighted Average Cost Formula: Cost Rate = (Period Purchase Amount ÷ Period Purchase Kg). If no inward purchases occurred during the period, cost falls back to historical inward purchases or Item Master default rate."
                           FontSize="10.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontStyle="Italic"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Total Revenue: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding FormattedTotalRevenue}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,14,0" />

                    <TextBlock Text="Total COGS: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding FormattedTotalCogs}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,14,0" />

                    <TextBlock Text="Net P/L: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding FormattedNetProfitLoss}" FontSize="11" FontWeight="Black" Foreground="{Binding IsNetProfitable, Converter={x:Null}}" Margin="0,0,14,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNetProfitable}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Overall Margin: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding FormattedMarginPercent}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
