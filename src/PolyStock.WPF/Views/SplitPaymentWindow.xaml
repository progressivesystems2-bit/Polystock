<Window x:Class="PolyStock.WPF.Views.SplitPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PolyStock.WPF.Converters"
        mc:Ignorable="d"
        Title="Split Payment Settlement"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. Bill Total Highlight -->
            <RowDefinition Height="Auto" />
            <!-- 2. Payment Allocations Form -->
            <RowDefinition Height="*" />
            <!-- 3. Validation / Remaining Credit Summary -->
            <RowDefinition Height="Auto" />
            <!-- 4. Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚖ Split Payment Settlement" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="Distribute bill total across Cash, UPI / QR, and remaining Credit balance." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Bill Total Banner -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="Bill Grand Total:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtGrandTotal" Text="₹ 0.00" FontWeight="Black" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Allocations Form Card -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <!-- 1. Cash Section -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="170">
                        <TextBlock Text="💵 Cash Received (₹)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Deposited into Cash In Hand" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBox x:Name="TxtCashAmount" Grid.Column="1" Height="36" TextAlignment="Right" FontWeight="Bold" FontSize="13"
                             TextChanged="Input_TextChanged" PreviewKeyDown="TxtCashAmount_PreviewKeyDown" />
                </Grid>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                <!-- 2. UPI / Online Section -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="170">
                        <TextBlock Text="📱 UPI Received (₹)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Collected via QR / Online" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBox x:Name="TxtUpiAmount" Grid.Column="1" Height="36" TextAlignment="Right" FontWeight="Bold" FontSize="13"
                             TextChanged="Input_TextChanged" PreviewKeyDown="TxtUpiAmount_PreviewKeyDown" />
                </Grid>

                <!-- UPI Account Selector -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="UPI / Bank Account *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="CmbUpiAccount" Grid.Column="1" Height="34" DisplayMemberPath="AccountName" ToolTip="Select which UPI or Bank account received the payment" />
                </Grid>

                <!-- UTR / Txn Ref -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="UTR / Ref No (Optional)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtUtrRef" Grid.Column="1" Height="34" ToolTip="Enter transaction reference or UTR number" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Remaining Credit Summary & Validation -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="💳 Remaining Customer Credit:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="Balance posted as receivable on customer ledger" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <TextBlock x:Name="TxtRemainingCredit" Text="₹ 0.00" FontWeight="Black" FontSize="16" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="4">
            <TextBlock x:Name="TxtWarning" Text="" Foreground="#DC2626" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left" TextWrapping="Wrap" MaxWidth="280" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="✕ Cancel (Esc)" Style="{StaticResource SecondaryButton}" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="BtnConfirm" Content="✓ Confirm Split (Enter)" Style="{StaticResource SuccessButton}" Padding="14,0" Height="36" Click="Confirm_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
