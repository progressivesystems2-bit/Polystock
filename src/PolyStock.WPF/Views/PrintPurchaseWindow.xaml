<Window x:Class="PolyStock.WPF.Views.PrintPurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PolyStock.WPF.Converters"
        mc:Ignorable="d"
        Title="Purchase Voucher Preview - PolyStock"
        Height="780" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#525659">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConverter" />
        <conv:WeightConverter x:Key="WeightConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Print Toolbar -->
        <Border Grid.Row="0" Background="#323639" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄 Goods Inward / Purchase Voucher Preview" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🖨  Print Voucher" Background="#2B7DE9" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,8" Margin="0,0,10,0" Click="Print_Click" />
                    <Button Content="Close" Background="#4F5356" Foreground="#FFFFFF" Padding="14,8" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Printable Document Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border x:Name="PrintArea"
                    Background="#FFFFFF"
                    Width="790"
                    MinHeight="1000"
                    Margin="20"
                    Padding="36"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="4" Direction="270" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="POLYSTOCK POLYMERS &amp; COMMODITIES" FontSize="20" FontWeight="Black" Foreground="#111827" />
                            <TextBlock Text="Wholesale &amp; Retail Dual-Bag Polymer Masterbatch Solutions" FontSize="11" Foreground="#4B5563" Margin="0,2,0,0" />
                            <TextBlock Text="Plot No. 42, Industrial Area, Phase II | Contact: +91 98765 43210" FontSize="10" Foreground="#6B7280" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="GOODS INWARD VOUCHER" FontSize="13" FontWeight="Black" Foreground="#1F2937" HorizontalAlignment="Center" />
                                <TextBlock Text="PURCHASE RECEIPT" FontSize="9" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Separator Background="#111827" Height="2" Margin="0,0,0,16" />

                    <!-- Meta Details -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Supplier Details -->
                        <Border Grid.Column="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="SUPPLIER / VENDOR:" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SupplierName}" FontSize="14" FontWeight="Bold" Foreground="#111827" />
                                <TextBlock Text="{Binding SelectedGodown.Name, StringFormat='Destination Godown: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Right: Voucher Metadata -->
                        <Border Grid.Column="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Inward Bill #:" FontWeight="Bold" FontSize="11" Foreground="#4B5563" Margin="0,2,8,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceNo}" FontWeight="Black" FontSize="12" Foreground="#111827" Margin="0,2,0,2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Inward Date:" FontWeight="Bold" FontSize="11" Foreground="#4B5563" Margin="0,2,8,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PurchaseDate, StringFormat='{}{0:dd-MMM-yyyy}'}" FontSize="11" Foreground="#111827" Margin="0,2,0,2" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Remarks:" FontWeight="Bold" FontSize="11" Foreground="#4B5563" Margin="0,2,8,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Notes, TargetNullValue='-'}" FontSize="11" Foreground="#111827" Margin="0,2,0,2" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Items Table -->
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" BorderBrush="#E5E7EB" BorderThickness="1" Background="#FFFFFF" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Description" Binding="{Binding Item.ItemName}" Width="2*" />
                            <DataGridTextColumn Header="Godown" Binding="{Binding SelectedGodown.Name}" Width="1.2*" />
                            <DataGridTextColumn Header="Pack Size" Binding="{Binding PackSizeValue, StringFormat='{}{0} kg'}" Width="80" />
                            <DataGridTextColumn Header="Bags" Binding="{Binding Bags}" Width="70" />
                            <DataGridTextColumn Header="Total Weight" Binding="{Binding TotalKg, Converter={StaticResource WeightConverter}}" Width="100" />
                            <DataGridTextColumn Header="Rate/kg" Binding="{Binding RatePerKg, Converter={StaticResource CurrencyConverter}}" Width="90" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary & Landed Costing -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="QUANTITY BREAKDOWN:" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding TotalBags, StringFormat='Total Full Bags Inward: {0} Bags'}" FontSize="12" FontWeight="Bold" Foreground="#111827" />
                                <TextBlock Text="{Binding TotalWeightKg, Converter={StaticResource WeightConverter}, StringFormat='Total Inward Net Weight: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#2B7DE9" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Sub Total:" Foreground="#4B5563" FontSize="11" />
                                    <TextBlock Text="{Binding SubTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="GST Amount:" Foreground="#4B5563" FontSize="11" />
                                    <TextBlock Text="{Binding GstAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Freight &amp; Loading:" Foreground="#4B5563" FontSize="11" />
                                    <TextBlock Text="{Binding TotalAdditionalCost, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Separator Background="#D1D5DB" Margin="0,4" />
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Grand Total:" FontWeight="Bold" FontSize="13" Foreground="#111827" />
                                    <TextBlock Text="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Black" FontSize="14" Foreground="#10B981" HorizontalAlignment="Right" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
