<Window x:Class="PolyStock.WPF.Views.PrintInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PolyStock.WPF.Converters"
        mc:Ignorable="d"
        Title="Print Invoice Preview - PolyStock"
        Height="780" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#525659">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConverter" />
        <conv:WeightConverter x:Key="WeightConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Print Toolbar -->
        <Border Grid.Row="0" Background="#323639" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄 Tax Invoice Print Preview" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🖨  Print Invoice" Background="#2B7DE9" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,8" Margin="0,0,10,0" Click="Print_Click" />
                    <Button Content="Close" Background="#4F5356" Foreground="#FFFFFF" Padding="14,8" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Printable Document Area (A4 white sheet styling) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border x:Name="PrintArea"
                    Background="#FFFFFF"
                    Width="790"
                    MinHeight="1000"
                    Margin="20"
                    Padding="36"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="4" Direction="270" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- Company & Document Title Header -->
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="POLYSTOCK POLYMERS &amp; COMMODITIES" FontSize="20" FontWeight="Black" Foreground="#111827" />
                            <TextBlock Text="Wholesale &amp; Retail Dual-Bag Polymer Masterbatch Solutions" FontSize="11" Foreground="#4B5563" Margin="0,2,0,0" />
                            <TextBlock Text="Plot No. 42, Industrial Area, Phase II | Contact: +91 98765 43210" FontSize="10" Foreground="#6B7280" Margin="0,2,0,0" />
                            <TextBlock Text="GSTIN / Reg No: 36ABCDE1234F1Z5" FontSize="10" FontWeight="SemiBold" Foreground="#374151" Margin="0,1,0,0" />
                        </StackPanel>

                        <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DocumentTitle, FallbackValue='TAX INVOICE'}" FontSize="14" FontWeight="Black" Foreground="#1F2937" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DocumentSubTitle, FallbackValue='ORIGINAL FOR RECIPIENT'}" FontSize="9" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Separator Background="#E5E7EB" Margin="0,0,0,16" />

                    <!-- Invoice & Customer/Supplier Metadata Box -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Bill To / Supplier -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PartyHeader, FallbackValue='BILLED TO / CUSTOMER:'}" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtCustomerName" Text="{Binding PartyName}" FontSize="15" FontWeight="Bold" Foreground="#111827" />
                                <TextBlock Text="Terms: Immediate / Standard Delivery" FontSize="11" Foreground="#4B5563" Margin="0,2,0,0" />
                                <TextBlock x:Name="TxtNotes" Text="{Binding Notes, StringFormat='Remarks: {0}'}" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Invoice Info -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Invoice / Bill No: " FontWeight="SemiBold" FontSize="12" Foreground="#374151" Margin="0,0,8,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtInvoiceNo" Text="{Binding InvoiceNo}" FontWeight="Bold" FontSize="12" Foreground="#111827" Margin="0,0,0,4" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DateLabel, FallbackValue='Invoice Date: '}" FontWeight="SemiBold" FontSize="12" Foreground="#374151" Margin="0,0,8,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSaleDate" Text="{Binding DateText}" FontSize="12" Foreground="#111827" Margin="0,0,0,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Place of Supply: " FontWeight="SemiBold" FontSize="12" Foreground="#374151" Margin="0,0,8,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Local State (Warehouse)" FontSize="12" Foreground="#111827" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Items Table -->
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                        <DataGrid x:Name="GridItems"
                                  ItemsSource="{Binding PrintItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5E7EB"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Background="#FFFFFF"
                                  RowHeight="32">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F4F6" />
                                    <Setter Property="Foreground" Value="#374151" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="BorderBrush" Value="#D1D5DB" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName}" Width="2*" />
                                <DataGridTextColumn Header="Pack Size" Binding="{Binding PackSize}" Width="80" />
                                <DataGridTextColumn Header="Bags (Qty)" Binding="{Binding Bags}" Width="75" />
                                <DataGridTextColumn Header="Loose (kg)" Binding="{Binding LooseKg}" Width="85" />
                                <DataGridTextColumn Header="Total Weight" Binding="{Binding TotalWeight, Converter={StaticResource WeightConverter}}" Width="100" />
                                <DataGridTextColumn Header="Rate / kg" Binding="{Binding Rate, Converter={StaticResource CurrencyConverter}}" Width="95" />
                                <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Totals & Summary Block -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="290" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="💡 Quantity &amp; Accounting Breakdown:" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtDualBreakdown" Text="{Binding DualBreakdownText}" FontSize="11" Foreground="#374151" />
                                <TextBlock Text="All rates are inclusive of packaging &amp; standard weighing." FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0" />
                                <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,8,12,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding PartyPostingText}" FontSize="11" FontWeight="Bold" Foreground="#3730A3" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Width="280">
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Total Bags: " FontSize="11" Foreground="#4B5563" />
                                    <TextBlock x:Name="TxtTotalBags" Text="{Binding TotalBags}" FontWeight="Bold" FontSize="11" Foreground="#111827" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Total Weight: " FontSize="11" Foreground="#4B5563" />
                                    <TextBlock x:Name="TxtTotalWeight" Text="{Binding TotalWeightKg, Converter={StaticResource WeightConverter}}" FontWeight="Bold" FontSize="11" Foreground="#111827" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Items SubTotal: " FontSize="11" Foreground="#4B5563" />
                                    <TextBlock Text="{Binding SubTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="11" Foreground="#111827" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="{Binding GstPercent, StringFormat='GST ({0}%): '}" FontSize="11" Foreground="#4B5563" />
                                    <TextBlock Text="{Binding GstAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="11" Foreground="#111827" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Freight: " FontSize="11" Foreground="#4B5563" />
                                    <TextBlock Text="{Binding Freight, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="11" Foreground="#111827" HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Loading/Unload: " FontSize="11" Foreground="#4B5563" />
                                    <TextBlock Text="{Binding LoadingUnloading, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="11" Foreground="#111827" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Separator Background="#D1D5DB" Margin="0,4" />
                                <DockPanel>
                                    <TextBlock Text="GRAND TOTAL: " FontWeight="Black" FontSize="14" Foreground="#111827" />
                                    <TextBlock x:Name="TxtGrandTotal" Text="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Black" FontSize="16" Foreground="#047857" HorizontalAlignment="Right" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Signatures and Terms Footer -->
                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Terms &amp; Conditions:" FontSize="10" FontWeight="Bold" Foreground="#374151" />
                            <TextBlock Text="1. Goods subject to verification and inspection on inward." FontSize="9" Foreground="#6B7280" />
                            <TextBlock Text="2. Subject to local jurisdiction." FontSize="9" Foreground="#6B7280" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding TermsPartyName, StringFormat='For {0}'}" FontSize="10" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Right" />
                            <Border Height="40" />
                            <TextBlock Text="Authorized Signatory" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
