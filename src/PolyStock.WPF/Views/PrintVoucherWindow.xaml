<Window x:Class="PolyStock.WPF.Views.PrintVoucherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PolyStock.WPF.Converters"
        mc:Ignorable="d"
        Title="Voucher Slip Preview - PolyStock"
        Height="700" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#525659">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Print Toolbar -->
        <Border Grid.Row="0" Background="#323639" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖨 Voucher Slip Preview" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <Border Background="#2563EB" CornerRadius="4" Padding="8,3" Margin="12,0,0,0">
                        <TextBlock Text="{Binding VoucherType, StringFormat='{}{0} VOUCHER'}" Foreground="#FFFFFF" FontWeight="Black" FontSize="11" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🖨  Print Slip" Background="#2B7DE9" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,8" Margin="0,0,10,0" Click="Print_Click" />
                    <Button Content="Close" Background="#4F5356" Foreground="#FFFFFF" Padding="14,8" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Printable Document Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border x:Name="PrintArea"
                    Background="#FFFFFF"
                    Width="740"
                    MinHeight="520"
                    Margin="20"
                    Padding="36"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="4" Direction="270" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="POLYSTOCK POLYMERS &amp; COMMODITIES" FontSize="18" FontWeight="Black" Foreground="#111827" />
                            <TextBlock Text="Payment, Receipt &amp; Journal Accounting Voucher Slip" FontSize="11" Foreground="#4B5563" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding VoucherType, StringFormat='{}{0} VOUCHER'}" FontSize="13" FontWeight="Black" Foreground="#1F2937" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding VoucherNo, StringFormat='{}# {0}'}" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Separator Background="#111827" Height="2" Margin="0,0,0,14" />

                    <!-- Meta Details -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Voucher Date:" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                            <TextBlock Text="{Binding VoucherDate, StringFormat='{}{0:dd-MMMM-yyyy}'}" FontSize="12" FontWeight="SemiBold" Foreground="#111827" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Payment Mode:" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                            <TextBlock Text="{Binding PaymentMode}" FontSize="12" FontWeight="SemiBold" Foreground="#111827" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="Reference / Cheque #:" FontSize="10" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ReferenceNo, TargetNullValue='-'}" FontSize="12" FontWeight="SemiBold" Foreground="#111827" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Primary Account Box (Cash / Bank) -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                        <DockPanel>
                            <TextBlock Text="Primary Account (Cash / Bank):" FontWeight="Bold" FontSize="11" Foreground="#4B5563" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PrimaryAccountName, TargetNullValue='Cash Account'}" FontWeight="Black" FontSize="13" Foreground="#111827" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Multi-Line Particulars Table -->
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Table Header -->
                            <Grid Background="#F3F4F6" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" FontSize="10" Foreground="#374151" HorizontalAlignment="Center" Margin="6,8" />
                                <TextBlock Grid.Column="1" Text="Particulars (Account)" FontWeight="Bold" FontSize="10" Foreground="#374151" Margin="6,8" />
                                <TextBlock Grid.Column="2" Text="Ref / Instrument #" FontWeight="Bold" FontSize="10" Foreground="#374151" Margin="6,8" />
                                <TextBlock Grid.Column="3" Text="Line Remarks" FontWeight="Bold" FontSize="10" Foreground="#374151" Margin="6,8" />
                                <TextBlock Grid.Column="4" Text="Amount" FontWeight="Bold" FontSize="10" Foreground="#374151" HorizontalAlignment="Right" Margin="6,8" />
                            </Grid>

                            <Separator Background="#D1D5DB" Height="1" Margin="0" />

                            <!-- Table Items -->
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="•" FontWeight="Bold" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding AccountName}" FontWeight="SemiBold" FontSize="12" Foreground="#111827" Margin="6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding ReferenceNo, TargetNullValue='-'}" FontSize="11" Foreground="#4B5563" Margin="6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Remarks, TargetNullValue='-'}" FontSize="11" Foreground="#4B5563" Margin="6,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding FormattedAmount}" FontWeight="Bold" FontSize="12" Foreground="#111827" HorizontalAlignment="Right" Margin="6,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Table Footer / Grand Total -->
                            <Border Background="#EFF6FF" Padding="12,10">
                                <DockPanel>
                                    <TextBlock Text="GRAND TOTAL AMOUNT" FontWeight="Black" FontSize="11" Foreground="#1E40AF" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}" FontWeight="Black" FontSize="16" Foreground="#1E3A8A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Narration -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,28">
                        <StackPanel>
                            <TextBlock Text="Narration / Remarks:" FontSize="9" FontWeight="Bold" Foreground="#6B7280" />
                            <TextBlock Text="{Binding Narration, TargetNullValue='No additional remarks.'}" FontSize="11" Foreground="#374151" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Signature Blocks -->
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <Separator Width="170" Background="#9CA3AF" Height="1" HorizontalAlignment="Left" />
                            <TextBlock Text="Prepared / Verified By" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Separator Width="170" Background="#9CA3AF" Height="1" HorizontalAlignment="Right" />
                            <TextBlock Text="Authorized Signatory / Receiver" FontSize="11" FontWeight="SemiBold" Foreground="#4B5563" HorizontalAlignment="Right" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
