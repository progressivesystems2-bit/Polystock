<UserControl x:Class="PolyStock.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Title Header -->
                <RowDefinition Height="Auto" />
                <!-- Settings Content Cards -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. HEADER SECTION -->
            <Border Grid.Row="0" Margin="0,0,0,20">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="System Settings &amp; Business Rules" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Configure inventory thresholds, deduction policies, and operational defaults" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. MAIN SETTINGS CARDS -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="540" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Inventory Deduction Threshold Card -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Card Header -->
                        <DockPanel Margin="0,0,0,16">
                            <Border Background="#1A0078D4" CornerRadius="6" Padding="6,6" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="16" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Inventory Deduction Threshold" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="Control whether small sample/loose quantities reduce warehouse stock" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Notification Banner -->
                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                            <Setter Property="Background" Value="#FEE2E2" />
                                            <Setter Property="BorderBrush" Value="#EF4444" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsErrorMessage}" Value="False">
                                            <Setter Property="Background" Value="#ECFDF5" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                                <Setter Property="Foreground" Value="#991B1B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsErrorMessage}" Value="False">
                                                <Setter Property="Foreground" Value="#065F46" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Threshold Input Form -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Minimum Sales Weight for Inventory Deduction (KG)" Style="{StaticResource FormLabel}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ThresholdKgText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         FontSize="15"
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource AccentBrush}"
                                         VerticalContentAlignment="Center"
                                         Padding="10,0" />
                                <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1" CornerRadius="0,6,6,0" Padding="14,0" VerticalAlignment="Stretch">
                                    <TextBlock Text="KG" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="💡 Set to 0 to disable (standard behavior: all sales deduct stock)."
                                       FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,0" />
                        </StackPanel>

                        <!-- Dynamic Status Summary Box -->
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                            <TextBlock Text="{Binding ThresholdStatusSummary}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="18" />
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Reset / Reload" Style="{StaticResource SecondaryButton}" Command="{Binding ResetCommand}" Margin="0,0,10,0" Height="36" Padding="16,0" />
                            <Button Content="💾 Save Settings" Command="{Binding SaveCommand}" Height="36" Padding="20,0" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Column: Explanations & Scenario Guide -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Border Background="#1A10B981" CornerRadius="6" Padding="6,6" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="ℹ️" FontSize="16" />
                                </Border>
                                <TextBlock Text="How the Inventory Threshold Works" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="This setting allows your business to sell small sample quantities or promotional loose weights without cutting full warehouse bags or depleting stock:"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="18" />

                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="1. Line Items Below Threshold (&lt; Threshold KG):" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="• Stock in warehouse is NOT deducted (Full bags and loose balances remain untouched)." FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="• No dynamic bag morphing or bag opening occurs." FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="• Insufficient stock does NOT block the sale from being completed." FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="2. Line Items At or Above Threshold (≥ Threshold KG):" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="• Warehouse inventory is subtracted normally according to dual-unit rules." FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="• Dynamic Bag Morphing opens a full bag for loose kg and creates a remainder bag." FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="3. Financial &amp; Customer Ledger Integrity:" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="• The sales invoice amount, GST calculation, freight, and customer ledger entries are 100% recorded and posted regardless of the inventory threshold." FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
