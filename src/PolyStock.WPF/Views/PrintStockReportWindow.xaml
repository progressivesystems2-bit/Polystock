<Window x:Class="PolyStock.WPF.Views.PrintStockReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PolyStock.WPF.Converters"
        mc:Ignorable="d"
        Title="Stock Inventory Report Preview - PolyStock"
        Height="800" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#525659">

    <Window.Resources>
        <conv:CurrencyConverter x:Key="CurrencyConverter" />
        <conv:WeightConverter x:Key="WeightConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Print Toolbar -->
        <Border Grid.Row="0" Background="#323639" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦 Stock Position &amp; Inventory Report Preview" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <Border Background="#4B5563" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="{Binding ViewModeTitle}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🖨  Print Report" Background="#2B7DE9" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,8" Margin="0,0,10,0" Click="Print_Click" />
                    <Button Content="Close" Background="#4F5356" Foreground="#FFFFFF" Padding="14,8" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Printable Document Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border x:Name="PrintArea"
                    Background="#FFFFFF"
                    Width="840"
                    MinHeight="1000"
                    Margin="20"
                    Padding="36"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="4" Direction="270" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- Company & Document Title Header -->
                    <DockPanel Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="POLYSTOCK POLYMERS &amp; COMMODITIES" FontSize="20" FontWeight="Black" Foreground="#111827" />
                            <TextBlock Text="Polymer Inventory &amp; Stock Balance Statement" FontSize="11" Foreground="#4B5563" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ViewModeTitle}" FontSize="12" FontWeight="Black" Foreground="#1F2937" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding FilteredItemCount, StringFormat='{}{0} Records Found'}" FontSize="9" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Separator Background="#111827" Height="2" Margin="0,0,0,14" />

                    <!-- KPI Summary Ribbon -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL INVENTORY WEIGHT" FontSize="9" FontWeight="Bold" Foreground="#6B7280" />
                                <TextBlock Text="{Binding TotalInventoryKg, Converter={StaticResource WeightConverter}}" FontSize="15" FontWeight="Black" Foreground="#111827" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TOTAL AVAILABLE BAGS" FontSize="9" FontWeight="Bold" Foreground="#6B7280" />
                                <TextBlock Text="{Binding TotalFullBags, StringFormat='{}{0} Bags'}" FontSize="15" FontWeight="Black" Foreground="#2B7DE9" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TOTAL VALUATION" FontSize="9" FontWeight="Bold" Foreground="#6B7280" />
                                <TextBlock Text="{Binding TotalValuation, Converter={StaticResource CurrencyConverter}}" FontSize="15" FontWeight="Black" Foreground="#111827" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Summary View Table -->
                    <DataGrid ItemsSource="{Binding FilteredSummaryList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              BorderBrush="#E5E7EB"
                              BorderThickness="1"
                              Background="#FFFFFF"
                              Visibility="{Binding IsSummaryView, Converter={StaticResource BoolToVisConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName}" Width="2.5*" />
                            <DataGridTextColumn Header="Group" Binding="{Binding HeadGroupName}" Width="*" />
                            <DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="*" />
                            <DataGridTextColumn Header="Total Bags" Binding="{Binding TotalBags, StringFormat='{}{0} Bags'}" Width="110" />
                            <DataGridTextColumn Header="Total Weight" Binding="{Binding TotalKg, Converter={StaticResource WeightConverter}}" Width="120" />
                            <DataGridTextColumn Header="Bag Breakdown" Binding="{Binding BagBreakdownSummary}" Width="1.5*" />
                            <DataGridTextColumn Header="Rate/kg" Binding="{Binding RatePerKg, Converter={StaticResource CurrencyConverter}}" Width="90" />
                            <DataGridTextColumn Header="Valuation" Binding="{Binding Valuation, Converter={StaticResource CurrencyConverter}}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Detailed View Table (Bag-wise) -->
                    <DataGrid ItemsSource="{Binding FilteredStockList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              BorderBrush="#E5E7EB"
                              BorderThickness="1"
                              Background="#FFFFFF"
                              Visibility="{Binding IsDetailedView, Converter={StaticResource BoolToVisConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Description" Binding="{Binding ItemName}" Width="2.5*" />
                            <DataGridTextColumn Header="Group" Binding="{Binding HeadGroupName}" Width="*" />
                            <DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="*" />
                            <DataGridTextColumn Header="Bag Weight" Binding="{Binding PackSizeKg, StringFormat='{}{0:0.##} kg'}" Width="100" />
                            <DataGridTextColumn Header="Available Bags" Binding="{Binding FullBags, StringFormat='{}{0} Bags'}" Width="110" />
                            <DataGridTextColumn Header="Total Weight" Binding="{Binding TotalKg, Converter={StaticResource WeightConverter}}" Width="120" />
                            <DataGridTextColumn Header="Rate/kg" Binding="{Binding RatePerKg, Converter={StaticResource CurrencyConverter}}" Width="95" />
                            <DataGridTextColumn Header="Valuation" Binding="{Binding Valuation, Converter={StaticResource CurrencyConverter}}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
