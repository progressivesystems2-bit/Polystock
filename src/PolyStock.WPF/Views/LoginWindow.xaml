<Window x:Class="PolyStock.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PolyStock - User Login &amp; Security"
        Width="440" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Segoe UI Variable, Inter, sans-serif"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header / Logo -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="12"
                        Width="48" Height="48"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                    <TextBlock Text="PS"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontWeight="Black"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="POLY" FontWeight="Black" FontSize="22" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="STOCK" FontWeight="Black" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>

                <TextBlock Text="Polymer Inventory &amp; Sales Management"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- 2. Login Form -->
            <StackPanel Grid.Row="1">
                <!-- Error Banner -->
                <Border x:Name="ErrorBanner"
                        Background="#FEE2E2"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessageText"
                               Text="Invalid username or password."
                               Foreground="#B91C1C"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Username -->
                <TextBlock Text="Username" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameTextBox"
                         Height="34"
                         FontSize="13.5"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Margin="0,0,0,14"
                         KeyDown="Input_KeyDown" />

                <!-- Password -->
                <TextBlock Text="Password" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordInputBox"
                             Height="34"
                             FontSize="13.5"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             Margin="0,0,0,6"
                             KeyDown="Input_KeyDown" />

                <!-- CapsLock Warning -->
                <TextBlock x:Name="CapsLockWarningText"
                           Text="⚠ Caps Lock is ON"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#D97706"
                           Margin="0,0,0,10"
                           Visibility="Collapsed" />

                <!-- Helper Badge for default admin -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6"
                        Margin="0,8,0,18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="💡 Default Credentials: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="admin / admin" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Exit"
                        Style="{StaticResource SecondaryButton}"
                        Height="38"
                        FontSize="13"
                        Click="ExitButton_Click"
                        IsCancel="True" />

                <Button Grid.Column="2"
                        Content="Log In ➔"
                        Height="38"
                        FontSize="13.5"
                        FontWeight="Bold"
                        Click="LoginButton_Click"
                        IsDefault="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
