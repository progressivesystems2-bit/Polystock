<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E5EB" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#E1E5EB" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#334155" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#106EBE" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4FB3F5" Offset="0" />
        <GradientStop Color="#0078D4" Offset="1" />
    </LinearGradientBrush>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#B8C4D2" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#64748B" />
    <SolidColorBrush x:Key="InputCaretBrush" Color="#0F172A" />

    <!-- Panels / tiles -->
    <SolidColorBrush x:Key="PanelBrush" Color="#EEF1F6" />

    <!-- Top bar -->
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F5F7FA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TopBarBorderBrush" Color="#E1E5EB" />
    <SolidColorBrush x:Key="TopBarTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TopBarSubTextBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TopBarOnDarkTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TopBarSearchBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TopBarSearchBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TopBarSearchTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TopBarSearchPlaceholderBrush" Color="#8A97AB" />
    <SolidColorBrush x:Key="TopBarSearchCaretBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="TopBarSearchIconBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TopBarGlassBgBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TopBarGlassBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TopBarGlassHoverBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TopBarButtonTextBrush" Color="#334155" />
    <SolidColorBrush x:Key="TopBarButtonHoverTextBrush" Color="#0F172A" />

    <!-- Status bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="StatusBarMutedBrush" Color="#64748B" />

    <!-- Misc -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#D3DCE6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EFF3F8" />
</ResourceDictionary>
