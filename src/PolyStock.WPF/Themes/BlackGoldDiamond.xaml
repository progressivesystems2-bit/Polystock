<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0A08" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#17140F" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2A24" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#14120D" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#2A2A24" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2E9D4" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8A47C" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#D4AF37" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E8C34A" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1A1306" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7D774" Offset="0" />
        <GradientStop Color="#B8860B" Offset="1" />
    </LinearGradientBrush>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1A1711" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3A332A" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#8A7A5E" />
    <SolidColorBrush x:Key="InputCaretBrush" Color="#F2E9D4" />

    <!-- Panels / tiles -->
    <SolidColorBrush x:Key="PanelBrush" Color="#1E1A13" />

    <!-- Top bar -->
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#16130D" Offset="0" />
        <GradientStop Color="#0B0A08" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TopBarBorderBrush" Color="#2A2A24" />
    <SolidColorBrush x:Key="TopBarTextBrush" Color="#F2E9D4" />
    <SolidColorBrush x:Key="TopBarSubTextBrush" Color="#B8A47C" />
    <SolidColorBrush x:Key="TopBarOnDarkTextBrush" Color="#F7EEDB" />
    <SolidColorBrush x:Key="TopBarSearchBgBrush" Color="#1C1914" />
    <SolidColorBrush x:Key="TopBarSearchBorderBrush" Color="#40D4AF37" />
    <SolidColorBrush x:Key="TopBarSearchTextBrush" Color="#F2E9D4" />
    <SolidColorBrush x:Key="TopBarSearchPlaceholderBrush" Color="#9C8C6E" />
    <SolidColorBrush x:Key="TopBarSearchCaretBrush" Color="#E8D9B8" />
    <SolidColorBrush x:Key="TopBarSearchIconBrush" Color="#D4AF37" />
    <SolidColorBrush x:Key="TopBarGlassBgBrush" Color="#1FD4AF37" />
    <SolidColorBrush x:Key="TopBarGlassBorderBrush" Color="#40D4AF37" />
    <SolidColorBrush x:Key="TopBarGlassHoverBrush" Color="#33F7D774" />
    <SolidColorBrush x:Key="TopBarButtonTextBrush" Color="#F2E9D4" />
    <SolidColorBrush x:Key="TopBarButtonHoverTextBrush" Color="#FFFFFF" />

    <!-- Status bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0B0A08" />
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#D8C49A" />
    <SolidColorBrush x:Key="StatusBarMutedBrush" Color="#5E5340" />

    <!-- Misc -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2A2A24" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#9ACD32" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E58A7A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#20FFFFFF" />
</ResourceDictionary>
