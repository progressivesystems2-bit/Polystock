<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F1E3" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFDF7" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E8DCC3" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFDF7" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#E8DCC3" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1208" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#42321C" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#B8860B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D9A020" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#2A1B06" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5BB4A" Offset="0" />
        <GradientStop Color="#B8860B" Offset="1" />
    </LinearGradientBrush>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFDF7" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C4B08A" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#6B583E" />
    <SolidColorBrush x:Key="InputCaretBrush" Color="#1A1208" />

    <!-- Panels / tiles -->
    <SolidColorBrush x:Key="PanelBrush" Color="#F4EBD9" />

    <!-- Top bar -->
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FDF6E7" Offset="0" />
        <GradientStop Color="#F3E7CD" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TopBarBorderBrush" Color="#E2D3B4" />
    <SolidColorBrush x:Key="TopBarTextBrush" Color="#1A1208" />
    <SolidColorBrush x:Key="TopBarSubTextBrush" Color="#5C4627" />
    <SolidColorBrush x:Key="TopBarOnDarkTextBrush" Color="#1A1208" />
    <SolidColorBrush x:Key="TopBarSearchBgBrush" Color="#FFFDF7" />
    <SolidColorBrush x:Key="TopBarSearchBorderBrush" Color="#D8C7A5" />
    <SolidColorBrush x:Key="TopBarSearchTextBrush" Color="#1A1208" />
    <SolidColorBrush x:Key="TopBarSearchPlaceholderBrush" Color="#8C7756" />
    <SolidColorBrush x:Key="TopBarSearchCaretBrush" Color="#B8860B" />
    <SolidColorBrush x:Key="TopBarSearchIconBrush" Color="#5C4627" />
    <SolidColorBrush x:Key="TopBarGlassBgBrush" Color="#F5EAD3" />
    <SolidColorBrush x:Key="TopBarGlassBorderBrush" Color="#D8C7A5" />
    <SolidColorBrush x:Key="TopBarGlassHoverBrush" Color="#EAD6B5" />
    <SolidColorBrush x:Key="TopBarButtonTextBrush" Color="#2A1B06" />
    <SolidColorBrush x:Key="TopBarButtonHoverTextBrush" Color="#B8860B" />

    <!-- Status bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#302414" />
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#E8DCC3" />
    <SolidColorBrush x:Key="StatusBarMutedBrush" Color="#9C8B70" />

    <!-- Misc -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E8DCC3" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6A8F2F" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FBF3E2" />
</ResourceDictionary>
