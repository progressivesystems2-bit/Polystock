<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2F7F4" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D6E4DC" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#D6E4DC" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F3A2E" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4F6E60" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#059669" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B8458" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#BFD4C9" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#7E998C" />
    <SolidColorBrush x:Key="InputCaretBrush" Color="#1F3A2E" />

    <!-- Panels / tiles -->
    <SolidColorBrush x:Key="PanelBrush" Color="#E8F2ED" />

    <!-- Top bar -->
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F0F7F3" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TopBarBorderBrush" Color="#D6E4DC" />
    <SolidColorBrush x:Key="TopBarTextBrush" Color="#1F3A2E" />
    <SolidColorBrush x:Key="TopBarSubTextBrush" Color="#4F6E60" />
    <SolidColorBrush x:Key="TopBarOnDarkTextBrush" Color="#1F3A2E" />
    <SolidColorBrush x:Key="TopBarSearchBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TopBarSearchBorderBrush" Color="#BFD4C9" />
    <SolidColorBrush x:Key="TopBarSearchTextBrush" Color="#1F3A2E" />
    <SolidColorBrush x:Key="TopBarSearchPlaceholderBrush" Color="#7E998C" />
    <SolidColorBrush x:Key="TopBarSearchCaretBrush" Color="#059669" />
    <SolidColorBrush x:Key="TopBarSearchIconBrush" Color="#4F6E60" />
    <SolidColorBrush x:Key="TopBarGlassBgBrush" Color="#EBF4F0" />
    <SolidColorBrush x:Key="TopBarGlassBorderBrush" Color="#BFD4C9" />
    <SolidColorBrush x:Key="TopBarGlassHoverBrush" Color="#DDF0E7" />
    <SolidColorBrush x:Key="TopBarButtonTextBrush" Color="#1F3A2E" />
    <SolidColorBrush x:Key="TopBarButtonHoverTextBrush" Color="#059669" />

    <!-- Status bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#12332A" />
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#C9E0D8" />
    <SolidColorBrush x:Key="StatusBarMutedBrush" Color="#5E8577" />

    <!-- Misc -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#D6E4DC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B57" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EDF7F2" />
</ResourceDictionary>
